# Local development environment variables
DATABASE_URL=sqlite:///aat_system.db
SECRET_KEY=replace-with-a-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
SERVICE_API_KEY=replace-with-your-service-api-key

# Local filesystem roots. Documents live on this device, not in a cloud bucket.
UPLOAD_ROOT=uploaded_files
REDACTED_ROOT=redacted_files
ARCHIVE_ROOT=repository

# LLM document analysis (Claude). Get a key at https://console.anthropic.com/
# Left as the placeholder below, the UI reports grading as unavailable rather
# than failing mid-run.
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
ANTHROPIC_MODEL=claude-opus-5
