# Local development environment variables
DATABASE_URL=sqlite:///aat_system.db
SECRET_KEY=replace-with-a-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
SERVICE_API_KEY=replace-with-your-service-api-key

# Local filesystem roots. Documents live on this device, not in a cloud bucket.
UPLOAD_ROOT=uploaded_files
REDACTED_ROOT=redacted_files
ARCHIVE_ROOT=repository

# ---------------------------------------------------------------------------
# LLM document analysis — where a use case's decision actually gets made.
#
# LLM_PROVIDER picks the route: 'tritonai' (default) or 'anthropic'.
# Left as a placeholder, either key makes the UI report grading as unavailable
# rather than failing mid-run.
# ---------------------------------------------------------------------------
LLM_PROVIDER=tritonai

# TritonAI — UCSD's OpenAI-compatible proxy. Generate a key with your UCSD
# login at https://tritonai-api.ucsd.edu/ ; model ids are listed at
# https://tritonai-api.ucsd.edu/ui/?page=models
# Cheap on-prem tier: api-llama-4-scout, gemini-3-flash, api-gpt-oss-120b
# Expensive AWS tier: gpt-5.4, gemini-3-pro-preview, claude-opus-4-6-v1
TRITONAI_API_KEY=replace-with-your-tritonai-key
TRITONAI_MODEL=claude-opus-4-6-v1

# Anthropic direct. Reads PDFs and images natively and enforces the response
# schema through the API, which the TritonAI route cannot do.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
ANTHROPIC_MODEL=claude-opus-5
